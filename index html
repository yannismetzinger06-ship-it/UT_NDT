<div id="notes"><div class="n-title" id="notesTitle">SPEAKER NOTES</div><div id="notesText"></div></div>

<script>
  const slides = Array.from(document.querySelectorAll(".slide"));
  const stage = document.getElementById("stage");
  const counter = document.getElementById("counter");
  const progress = document.getElementById("progress");
  const badge = document.getElementById("speakerBadge");
  const notes = document.getElementById("notes");
  const notesText = document.getElementById("notesText");
  const notesTitle = document.getElementById("notesTitle");
  const timerEl = document.getElementById("timer");
  const help = document.getElementById("help");

  const TOTAL_SECONDS = 10 * 60;
  let current = 0;
  let timerStart = null;
  let timerInterval = null;

  /* Scale the 1280x720 stage to fit any screen */
  function fit() {
    const scale = Math.min(window.innerWidth / 1280, window.innerHeight / 720);
    stage.style.transform = "scale(" + scale + ")";
  }
  window.addEventListener("resize", fit);
  fit();

  function show(index) {
    if (index < 0 || index >= slides.length) return;
    slides.forEach(function (s, i) {
      s.classList.toggle("active", i === index);
      s.classList.toggle("prev", i < index);
    });
    current = index;
    counter.textContent = (index + 1) + " / " + slides.length;
    progress.style.width = ((index + 1) / slides.length * 100) + "%";
    badge.innerHTML = "Speaker <b>" + slides[index].dataset.speaker + "</b>";

    const n = slides[index].querySelector(".speaker-notes");
    notesText.textContent = n ? n.textContent.trim() : "";
    notesTitle.textContent = "SPEAKER " + slides[index].dataset.speaker + " · SLIDE " + (index + 1);

    if (index > 0 && !timerStart) startTimer();
  }

  function startTimer() {
    timerStart = Date.now();
    clearInterval(timerInterval);
    timerInterval = setInterval(updateTimer, 500);
  }

  function resetTimer() {
    timerStart = null;
    clearInterval(timerInterval);
    timerEl.textContent = "00:00";
    timerEl.classList.remove("over");
  }

  function updateTimer() {
    const s = Math.floor((Date.now() - timerStart) / 1000);
    const m = String(Math.floor(s / 60)).padStart(2, "0");
    const sec = String(s % 60).padStart(2, "0");
    timerEl.textContent = m + ":" + sec;
    timerEl.classList.toggle("over", s > TOTAL_SECONDS);
  }

  function next() { show(current + 1); }
  function prev() { show(current - 1); }

  document.addEventListener("keydown", function (e) {
    if (["ArrowRight", "ArrowDown", "PageDown", " ", "Enter"].includes(e.key)) { e.preventDefault(); next(); }
    else if (["ArrowLeft", "ArrowUp", "PageUp", "Backspace"].includes(e.key)) { e.preventDefault(); prev(); }
    else if (e.key === "Home") show(0);
    else if (e.key === "End") show(slides.length - 1);
    else if (e.key.toLowerCase() === "n") notes.classList.toggle("show");
    else if (e.key.toLowerCase() === "t") resetTimer();
    else if (e.key.toLowerCase() === "f") {
      if (!document.fullscreenElement) document.documentElement.requestFullscreen();
      else document.exitFullscreen();
    }
  });

  /* Click: right half = next, left half = previous */
  document.getElementById("viewport").addEventListener("click", function (e) {
    if (e.clientX > window.innerWidth / 2) next(); else prev();
  });

  /* Swipe on touch screens */
  let touchX = null;
  document.addEventListener("touchstart", function (e) { touchX = e.touches[0].clientX; });
  document.addEventListener("touchend", function (e) {
    if (touchX === null) return;
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) { dx < 0 ? next() : prev(); }
    touchX = null;
  });

  /* Hide help text after a few seconds */
  setTimeout(function () { help.style.opacity = "0"; }, 5000);

  show(0);
</script>
